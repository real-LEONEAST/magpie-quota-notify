{
  "name": "magpie-quota-notify",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "main": "./index.mjs",
  "description": "Magpie quota alerts with shared global rules, merged notifications, scheduled overviews, MeoW, Bark, PushPlus, ServerChan, Telegram and webhooks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/real-LEONEAST/magpie-quota-notify.git"
  },
  "keywords": ["magpie", "magpie-plugin", "quota", "notifications", "meow", "bark", "pushplus", "serverchan", "telegram"],
  "files": [
    "index.mjs", "core.mjs", "channels.mjs", "quota.mjs", "runtime.mjs",
    "overview.mjs", "settings.mjs", "service.mjs", "state-lock.mjs", "reset-feed.mjs",
    "page/", "README.md", "LICENSE", "CHANGELOG.md"
  ],
  "engines": { "bun": ">=1.4.2" },
  "magpie": {
    "name": "额度通知 · MeoW / Bark / Webhook",
    "icon": "data:image/png;base64,",
    "summary": {
      "zh": "可视化额度通知，所有渠道共享事件与账号规则、同轮合并和定时概览，支持微信、Telegram、MeoW、Bark 与 Webhook。",
      "en": "Visual quota alerts with shared global event/account rules, merged messages and scheduled overviews via WeChat, Telegram, MeoW, Bark and webhooks."
    },
    "page": {
      "title": "额度通知设置",
      "file": "page/index.html",
      "icon": "page/icon.png",
      "service": { "port": 3479, "option": "uiPort" }
    },
    "options": {
      "pollSeconds": 300,
      "readMode": "live",
      "providers": [],
      "lowPercent": 90,
      "lowThresholds": [50, 20, 10],
      "notifyLow": true,
      "notifyExhausted": true,
      "notifyRecovered": true,
      "notifyOnStart": false,
      "timeZone": "Asia/Shanghai",
      "testTag": "",
      "channels": [
        { "type": "meow", "nickname": "", "category": "Magpie额度" }
      ]
    }
  }
}
